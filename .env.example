# Copy this file to ".env" (same folder) and restart "npm run dev".
# true  = use built-in demo data and demo accounts (no backend needed)
# false = log in through the real Spring Boot API
VITE_USE_MOCK=true

# Leave empty in development (Vite forwards /api to http://localhost:8080).
# For production set the full backend address, e.g. https://api.yourcollege.edu
VITE_API_BASE_URL=
